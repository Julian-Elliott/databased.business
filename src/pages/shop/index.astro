---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCTS, formatPrice } from '../../lib/products';
import { AUTHOR } from '../../consts';

// All commerce machinery (api/checkout, api/checkout-status, lib/stripe,
// lib/products) is intentionally left in place. Flipping `LAUNCHED` to
// true on a future iteration restores the live product page.
const LAUNCHED = false;

const product = PRODUCTS['tee-transparent-opaque'];
const price = formatPrice(product.unit_amount, product.currency);
const todayIso = new Date().toISOString().slice(0, 10);

type Status = 'done' | 'running' | 'pending';
interface Stage {
  idx: string;
  name: string;
  detail: string;
  status: Status;
  duration?: string;
  ts?: string;
}

// Build-log style pipeline. Tweak as the actual schedule moves.
const stages: Stage[] = [
  { idx: '01', name: 'design',          detail: 'transparent / opaque wordmark · 2-colour spec',                   status: 'done',    duration: '02d 04h', ts: '2026-01-12' },
  { idx: '02', name: 'fabric',          detail: '280gsm heavyweight cotton · cream · unisex block',                status: 'done',    duration: '01d 08h', ts: '2026-01-15' },
  { idx: '03', name: 'fulfilment',      detail: 'printful pod evaluation · margin maths',                          status: 'running', duration: '— h',     ts: 'now' },
  { idx: '04', name: 'print proof',     detail: 'screen print · oxidised orange + petrol blue · sample run',       status: 'pending' },
  { idx: '05', name: 'photography',     detail: 'flat lay + on-body · neutral paper backdrop',                     status: 'pending' },
  { idx: '06', name: 'stripe.prod',     detail: 'live api key · `wrangler secret put STRIPE_API_KEY`',             status: 'pending' },
  { idx: '07', name: 'qc',              detail: 'fit, wash, alignment, colour cast at delta-e &lt; 3',             status: 'pending' },
  { idx: '08', name: 'go live',         detail: '/shop · this page flips to product',                              status: 'pending' },
];

function statusLabel(s: Status): string {
  return s === 'done' ? 'done' : s === 'running' ? 'running' : 'pending';
}
function statusGlyph(s: Status): string {
  return s === 'done' ? '✓' : s === 'running' ? '⟳' : ' ';
}

const dagNodes = [
  { lbl: 'design',     status: 'done' as Status },
  { lbl: 'fulfil',     status: 'running' as Status },
  { lbl: 'proof',      status: 'pending' as Status },
  { lbl: 'photo',      status: 'pending' as Status },
  { lbl: 'stripe',     status: 'pending' as Status },
  { lbl: 'qc',         status: 'pending' as Status },
  { lbl: 'live',       status: 'pending' as Status },
];

const completedCount = stages.filter((s) => s.status === 'done').length;
const totalCount = stages.length;
const pct = Math.round((completedCount / totalCount) * 100);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="shop · coming soon"
      description={`${product.name} — coming soon. ${price} on launch. Pipeline currently ${pct}% complete.`}
    />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap" data-testid="shop-coming-soon">

      <header class="page-head">
        <div class="meta-line">
          <span class="mono label">04 · shop</span>
          <span class="dot" aria-hidden="true"></span>
          <span class="mono dim">pipeline_id sku.tee.transparent_opaque · {todayIso}</span>
        </div>

        <h1 class="page-title">shop<span class="period">.</span></h1>

        <p class="lead">
          One thing is coming. <em>Transparent / Opaque</em> on a cream
          heavyweight tee, screen-printed in two colours. The page below is
          the build pipeline, not a placeholder.
        </p>
      </header>

      {/* ─── PIPELINE BANNER ─────────────────────────────────────── */}
      <section class="banner" data-testid="pipeline-banner" aria-label="Pipeline status">
        <div class="banner-row">
          <span class="mono lbl">status</span>
          <span class="mono badge --running">RUNNING</span>
          <span class="mono lbl">progress</span>
          <span class="mono val">{completedCount}/{totalCount} · {pct}%</span>
          <span class="mono lbl">target ship</span>
          <span class="mono val">tbc · q2 2026</span>
        </div>
        <div class="progress" role="progressbar" aria-valuenow={pct} aria-valuemin={0} aria-valuemax={100} aria-label="Pipeline progress">
          <div class="bar" style={`width: ${pct}%`}></div>
          <span class="ticks" aria-hidden="true">
            {Array.from({ length: 10 }).map(() => <span class="tick"></span>)}
          </span>
        </div>
      </section>

      {/* ─── BUILD LOG ───────────────────────────────────────────── */}
      <section class="log" data-testid="pipeline-log" aria-label="Build log">
        <header class="rubric">
          <span class="idx">04.a</span>
          <h2 class="title">build log</h2>
          <span class="meta">↘ stage · status · detail</span>
        </header>

        <ol class="stages">
          {stages.map((s) => (
            <li
              class={`stage --${s.status}`}
              data-testid={`stage-${s.idx}`}
              data-status={s.status}
            >
              <span class="glyph" aria-hidden="true">[<span class="glyph-inner">{statusGlyph(s.status)}</span>]</span>
              <span class="idx mono">{s.idx}</span>
              <span class="name mono">{s.name}</span>
              <span class="detail" set:html={s.detail}></span>
              <span class="status-pill mono">{statusLabel(s.status)}</span>
              <span class="ts mono">{s.ts ?? '—'}</span>
            </li>
          ))}
        </ol>
      </section>

      {/* ─── DAG ────────────────────────────────────────────────── */}
      <section class="dag" data-testid="pipeline-dag" aria-label="Pipeline DAG">
        <header class="rubric">
          <span class="idx">04.b</span>
          <h2 class="title">dag</h2>
          <span class="meta">↘ left-to-right</span>
        </header>

        <div class="dag-scroll">
          <div class="dag-row" role="list">
            {dagNodes.map((n, i) => (
              <>
                <div class={`node --${n.status}`} role="listitem" data-testid={`dag-${n.lbl}`}>
                  <span class="glyph mono">{statusGlyph(n.status)}</span>
                  <span class="lbl mono">{n.lbl}</span>
                </div>
                {i < dagNodes.length - 1 && (
                  <span class="edge mono" aria-hidden="true">──▶</span>
                )}
              </>
            ))}
          </div>
        </div>
      </section>

      {/* ─── SPEC PEEK ──────────────────────────────────────────── */}
      <section class="spec" data-testid="product-spec" aria-label="Product specification">
        <header class="rubric">
          <span class="idx">04.c</span>
          <h2 class="title">on launch</h2>
          <span class="meta">↘ provisional</span>
        </header>

        <dl class="kv spec-kv">
          <dt>sku</dt><dd class="mono">{product.sku}</dd>
          <dt>price</dt><dd class="mono">{price} <span class="dim">· gbp</span></dd>
          <dt>fabric</dt><dd>280gsm heavyweight cotton</dd>
          <dt>print</dt><dd>2-colour screen · oxidised orange + petrol blue</dd>
          <dt>sizes</dt><dd>{product.sizes.join(' · ')}</dd>
          <dt>ships to</dt><dd>uk · eu · worldwide tracked</dd>
        </dl>
      </section>

      {/* ─── PING ───────────────────────────────────────────────── */}
      <section class="ping" data-testid="ping-cta">
        <header class="rubric">
          <span class="idx">04.d</span>
          <h2 class="title">ping me</h2>
        </header>

        <p class="muted">
          No mailing list, no form, no analytics. If you want a single email
          when the pipeline ships, drop me a line —
        </p>
        <p class="cta">
          <a
            class="mailto mono"
            href={`mailto:${AUTHOR.email}?subject=ping%20me%20when%20the%20tee%20ships&body=Hi%20Julian%20—%20add%20me%20to%20the%20one-shot%20list%20for%20the%20transparent%20%2F%20opaque%20tee.`}
            data-testid="ping-mailto"
          >→ {AUTHOR.email}</a>
        </p>
        <p class="micro mono muted">
          // i'll reply once, when the page flips. no other use.
        </p>
      </section>

    </main>
    <Footer />

    <style>
      .page-head { padding: var(--s-5) 0 var(--s-3); }

      .meta-line {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        font-family: var(--f-mono);
        font-size: var(--t-mono);
        letter-spacing: 0.04em;
        margin-bottom: var(--s-3);
        flex-wrap: wrap;
      }
      .meta-line .label { color: var(--ink-3); }
      .meta-line .dim { color: var(--ink-3); }
      .meta-line .dot {
        width: 5px; height: 5px;
        background: var(--signal);
        border-radius: 50%;
        animation: blink 2.4s steps(2) infinite;
      }
      @keyframes blink { 50% { opacity: 0.25; } }

      .page-title {
        font-family: var(--f-display);
        font-size: clamp(48px, 9vw, 96px);
        line-height: 0.96;
        margin: 6px 0 var(--s-2) 0;
        font-variation-settings: "opsz" 144, "SOFT" 40, "WONK" 1;
        letter-spacing: -0.03em;
        color: var(--signal);
      }
      .page-title .period { color: var(--ink); }

      .lead {
        max-width: 56ch;
        font-size: clamp(17px, 1.3vw, 20px);
        color: var(--ink-2);
        margin-bottom: var(--s-3);
      }

      /* ── banner ───────────────────────────────────────── */
      .banner {
        margin: var(--s-3) 0 var(--s-4) 0;
        border: 1px solid var(--rule);
        background: var(--bg-card);
        padding: var(--s-2) var(--s-3);
      }
      .banner-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        align-items: center;
        font-size: var(--t-mono);
      }
      .banner-row .lbl { color: var(--ink-3); }
      .banner-row .val { color: var(--ink); }
      .banner-row .badge {
        padding: 2px 8px;
        border: 1px solid var(--rule);
        border-radius: 2px;
        letter-spacing: 0.08em;
        font-size: 11.5px;
      }
      .banner-row .badge.--running {
        color: var(--signal);
        border-color: color-mix(in srgb, var(--signal) 50%, var(--rule));
        background: color-mix(in srgb, var(--signal) 6%, transparent);
      }
      .progress {
        margin-top: 10px;
        position: relative;
        height: 8px;
        background: var(--paper-2);
        border: 1px solid var(--rule);
        overflow: hidden;
      }
      .bar {
        height: 100%;
        background:
          repeating-linear-gradient(
            45deg,
            var(--signal),
            var(--signal) 4px,
            color-mix(in srgb, var(--signal) 75%, transparent) 4px,
            color-mix(in srgb, var(--signal) 75%, transparent) 8px
          );
        transition: width .8s ease;
        animation: stripe 1.4s linear infinite;
      }
      @keyframes stripe {
        0%   { background-position:   0 0; }
        100% { background-position: 24px 0; }
      }
      .ticks {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(10, 1fr);
      }
      .ticks .tick {
        border-right: 1px solid color-mix(in srgb, var(--paper) 70%, transparent);
      }
      .ticks .tick:last-child { border-right: 0; }

      /* ── build log ────────────────────────────────────── */
      .log { padding-bottom: var(--s-4); }
      .stages {
        list-style: none;
        margin: var(--s-2) 0 0 0;
        padding: 0;
        font-family: var(--f-mono);
        font-size: 13.5px;
      }
      .stage {
        display: grid;
        grid-template-columns: 28px 32px 110px 1fr 90px 110px;
        align-items: baseline;
        gap: 12px;
        padding: 10px 12px;
        border-top: 1px solid var(--rule);
        color: var(--ink-2);
      }
      .stage:last-child { border-bottom: 1px solid var(--rule); }
      .stage .glyph { color: var(--ink-3); }
      .stage .idx { color: var(--ink-3); }
      .stage .name { color: var(--ink); letter-spacing: 0.02em; }
      .stage .detail {
        color: var(--ink-2);
        font-family: var(--f-body);
        font-size: 14.5px;
        line-height: 1.45;
        min-width: 0;
        word-wrap: break-word;
      }
      .stage .status-pill {
        color: var(--ink-3);
        font-size: 11.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-align: right;
      }
      .stage .ts { color: var(--ink-3); text-align: right; font-size: 12px; }

      .stage.--done .glyph-inner { color: var(--depth); }
      .stage.--done .name { color: var(--ink); }
      .stage.--done .status-pill { color: var(--depth); }

      .stage.--running { background: color-mix(in srgb, var(--signal) 5%, transparent); }
      .stage.--running .glyph-inner {
        color: var(--signal);
        display: inline-block;
        animation: spin 1.6s linear infinite;
      }
      .stage.--running .name { color: var(--signal); }
      .stage.--running .status-pill { color: var(--signal); }
      .stage.--running .ts { color: var(--signal); }
      @keyframes spin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }

      .stage.--pending .name { color: var(--ink-3); }
      .stage.--pending .detail { color: var(--ink-3); }

      @media (max-width: 800px) {
        .stage {
          grid-template-columns: 22px 28px 1fr 80px;
        }
        .stage .detail { grid-column: 2 / -1; }
        .stage .ts { display: none; }
      }

      /* ── DAG ──────────────────────────────────────────── */
      .dag { padding-bottom: var(--s-4); }
      .dag-scroll {
        margin-top: var(--s-2);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: var(--s-3) var(--s-2);
        border: 1px solid var(--rule);
        background: var(--bg-card);
      }
      .dag-row {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: max-content;
      }
      .node {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px solid var(--rule);
        background: var(--paper);
        font-family: var(--f-mono);
        font-size: 13px;
        color: var(--ink-2);
        white-space: nowrap;
      }
      .node .glyph { color: var(--ink-3); }
      .edge {
        color: var(--ink-3);
        letter-spacing: -0.1em;
        font-size: 14px;
      }
      .node.--done { border-color: color-mix(in srgb, var(--depth) 50%, var(--rule)); color: var(--depth); }
      .node.--done .glyph { color: var(--depth); }
      .node.--running {
        border-color: var(--signal);
        color: var(--signal);
        background: color-mix(in srgb, var(--signal) 7%, var(--paper));
      }
      .node.--running .glyph {
        color: var(--signal);
        display: inline-block;
        animation: spin 1.6s linear infinite;
      }
      .node.--pending { color: var(--ink-3); }

      /* ── spec ─────────────────────────────────────────── */
      .spec { padding-bottom: var(--s-4); }
      .spec-kv {
        grid-template-columns: 90px 1fr;
        max-width: 640px;
        margin-top: var(--s-2);
      }
      .spec-kv .dim { color: var(--ink-3); }

      /* ── ping ─────────────────────────────────────────── */
      .ping { padding-bottom: var(--s-6); }
      .ping .muted { max-width: 60ch; }
      .cta { margin: var(--s-2) 0 var(--s-1) 0; }
      .mailto {
        display: inline-block;
        padding: 10px 16px;
        border: 1px solid var(--ink);
        background: var(--ink);
        color: var(--paper);
        font-size: 14px;
        letter-spacing: 0.02em;
        transition: background .2s ease, color .2s ease, transform .15s ease;
      }
      .mailto:hover {
        background: var(--signal);
        border-color: var(--signal);
        color: var(--paper);
        transform: translateY(-1px);
      }
      .micro { font-size: 11.5px; margin: 6px 0 0 0; }
    </style>
  </body>
</html>
