---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostRow from '../components/PostRow.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tags = Array.from(
  new Set(posts.map((p) => p.data.tag).filter((t): t is string => !!t)),
);

const todayIso = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap" data-testid="home-main">

      <header class="page-head" data-testid="page-head">
        <div class="meta-line">
          <span class="mono">log // {todayIso}</span>
          <span class="dot" aria-hidden="true"></span>
          <span class="mono">julian elliott · msc data analytics</span>
        </div>

        <h1 class="page-title">
          <span class="depth">transparent</span><span class="slash"> / </span><span class="signal">opaque</span><span class="period">.</span>
        </h1>

        <p class="lead">
          Field notes on data, models, and what we can defend in plain English.
          Built for engineers and analysts who want the maths shown — not summarised.
        </p>

        <div class="filters" data-testid="filters">
          <button class="chip active" data-filter="all" data-testid="filter-all">all <span class="dim">· {posts.length}</span></button>
          {tags.map((t) => (
            <button class="chip" data-filter={t} data-testid={`filter-${t}`}>{t.toLowerCase()}</button>
          ))}
        </div>
      </header>

      <section class="rows" data-testid="post-rows" aria-label="Field notes">
        {posts.map((p, i) => (
          <div class="row-wrap" data-tag={p.data.tag ?? ''}>
            <PostRow
              href={`/blog/${p.id}/`}
              idx={String(i + 1).padStart(2, '0')}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              readingTime={p.data.readingTime}
              tag={p.data.tag}
              spark={p.data.spark}
            />
          </div>
        ))}
      </section>

    </main>
    <Footer />

    <script is:inline>
      (function () {
        var buttons = document.querySelectorAll('[data-filter]');
        var rows = document.querySelectorAll('[data-tag]');
        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var f = btn.getAttribute('data-filter');
            buttons.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            rows.forEach(function (r) {
              if (f === 'all' || r.getAttribute('data-tag') === f) {
                r.style.display = '';
              } else {
                r.style.display = 'none';
              }
            });
          });
        });
      })();
    </script>

    <style>
      .page-head { padding: var(--s-5) 0 var(--s-3); }

      .meta-line {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        font-family: var(--f-mono);
        font-size: var(--t-mono);
        color: var(--ink-3);
        letter-spacing: 0.04em;
        margin-bottom: var(--s-3);
      }
      .meta-line .dot {
        width: 5px; height: 5px;
        background: var(--signal);
        border-radius: 50%;
        animation: blink 2.4s steps(2) infinite;
      }
      @keyframes blink { 50% { opacity: 0.25; } }

      .page-title {
        font-family: var(--f-display);
        font-variation-settings: "opsz" 144, "SOFT" 40, "WONK" 1;
        font-weight: 400;
        letter-spacing: -0.035em;
        margin: 0 0 var(--s-3) 0;
        font-size: clamp(48px, 11vw, 132px);
        line-height: 0.94;
      }
      .page-title .slash { color: var(--ink-3); font-style: italic; }
      .page-title .period { color: var(--signal); }
      .page-title .depth { color: var(--depth); }
      .page-title .signal { color: var(--signal); font-style: italic; }

      @media (max-width: 560px) {
        .page-title {
          font-size: clamp(40px, 16vw, 84px);
          letter-spacing: -0.045em;
        }
        .page-title .depth,
        .page-title .signal { display: inline-block; }
        .page-title .slash {
          display: block;
          height: 0;
          overflow: hidden;
        }
        .page-title .signal::before {
          content: "/ ";
          color: var(--ink-3);
          font-style: italic;
        }
      }

      .lead {
        max-width: 56ch;
        font-size: clamp(17px, 1.3vw, 20px);
        color: var(--ink-2);
        margin-bottom: var(--s-3);
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: var(--s-2);
        margin-bottom: var(--s-2);
      }
      .filters .chip {
        cursor: pointer;
        transition: border-color .15s ease, color .15s ease, background .15s ease;
      }
      .filters .chip:hover { border-color: var(--signal); color: var(--signal); }
      .filters .chip.active {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
      }
      .filters .dim { color: var(--ink-3); }
      .filters .chip.active .dim { color: color-mix(in srgb, var(--paper) 70%, transparent); }

      .rows { padding-bottom: var(--s-6); }
    </style>
  </body>
</html>
