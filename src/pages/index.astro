---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import summary from '../../public/data/ds001/summary.json';

const sheets = (await getCollection('datasheets')).sort((a, b) => a.data.order - b.data.order);
const released = sheets.filter((s) => s.data.status === 'released').length;
const CHIP: Record<string, string> = { released: 'chip ok', sanitising: 'chip warm', locating: 'chip', cleaning: 'chip', planned: 'chip' };
const daily = summary.daily as { d: string; v: number }[];
const swDay = summary.days.sw.example as { t: string; v: number }[];
---
<Base title="databased.business · datasets, published as datasheets" description="Data, based in reality. Datasets Julian Elliott collected, cleaned or rebuilt, each with a datasheet: what it measures, where it came from, its limits, an example query that runs in your browser, and a download.">
<div class="wrap">
  <div class="mono warm" style="margin-bottom: 16px">Datasets, published as datasheets</div>
  <h1 class="display h1" style="font-size: 64px; max-width: 760px">Data, based in reality.</h1>
  <p class="lead" style="font-size: 20px; max-width: 680px; margin: 22px 0 10px">Datasets I collected, cleaned or rebuilt, each with a datasheet: what it measures, where it came from, its limits, an example query, and a download. Read it, query it in the browser, or print it.</p>
  <p style="font-size: 14.5px; color: var(--muted); max-width: 680px; margin: 0 0 40px">Raw captures never leave my machine. A manifest names the columns a release may contain; a script builds the public files from it; the checks run in public. <a href="#how">How that works</a>.</p>

  <div class="mono ink" id="shelf" style="border-bottom: 1px solid var(--ink); padding-bottom: 8px; margin-bottom: 20px; display: flex; justify-content: space-between"><span>The shelf</span><span style="color: var(--faint)">{sheets.length} datasheets · {released} released</span></div>
  <div class="grid3">
    {sheets.map((s) => (
      <a class="card" href={`/datasheets/${s.data.id}/`} style={s.data.status === 'planned' ? 'min-height: 0' : ''}>
        <div class="top"><span class="mono" style="color: var(--accent)">{s.data.id.toUpperCase()}</span><span class={CHIP[s.data.status]}>{s.data.status}</span></div>
        <h3>{s.data.title}</h3>
        <p>{s.data.summary}</p>
        {s.data.id === 'ds-001' && <div class="spark" aria-label="Daily mean intensity, last 12 months">{daily.map((d) => <i style={`height:${Math.round((d.v / 270) * 100)}%`}></i>)}</div>}
        {s.data.id === 'ds-002' && <div class="spark" aria-label="South Wales, 29 September 2026">{swDay.map((h) => <i style={`height:${Math.round((h.v / 400) * 100)}%;margin-right:1px`}></i>)}</div>}
        {s.data.noRelease && <div class="nodata"><span class="mono">{s.data.noRelease}</span></div>}
        <div class="kv">{s.data.kv.map(([k, v]) => <span>{k}<b>{v}</b></span>)}</div>
      </a>
    ))}
    <div class="card" style="min-height: 0; justify-content: center; align-items: flex-start; border-style: dashed; box-shadow: none; background: transparent">
      <span class="mono">Want one of these sooner?</span>
      <p>Ask, and say what you’d do with it. Requests decide the order.</p>
      <a class="pill" href="mailto:julianpaulelliott@icloud.com">Email Julian</a>
    </div>
  </div>

  <div class="mono ink" id="how" style="border-bottom: 1px solid var(--ink); padding-bottom: 8px; margin: 64px 0 20px">How a release happens</div>
  <div class="steps4">
    <div class="step"><span class="mono">01 · Raw stays private</span>Captures, exports and API pulls live on my machine and never in the site repository.</div>
    <div class="step"><span class="mono">02 · The manifest decides</span>A datapackage.json names every column a release may carry, its type, unit and licence. Anything not named is not released.</div>
    <div class="step"><span class="mono">03 · Checks run in public</span>Schema, gaps, nulls and ranges run on the built files; results print on the datasheet.</div>
    <div class="step"><span class="mono">04 · Files are the release</span>Parquet with a revision date. The datasheet is the label on the tin, not the tin.</div>
  </div>
  <p style="font-size: 14px; color: var(--muted); margin-top: 40px">The notebook these datasets feed is at <a href="https://julian-elliott.github.io/">julian-elliott.github.io</a>. Source for this site: <a href="https://github.com/Julian-Elliott/databased.business">GitHub</a>.</p>
</div>
</Base>
