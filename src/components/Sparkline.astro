---
interface Props {
  values: number[];
  width?: number;
  height?: number;
  color?: string;
}
const { values, width = 72, height = 18, color } = Astro.props;

const n = values.length;
const min = Math.min(...values);
const max = Math.max(...values);
const range = max - min || 1;
const step = n > 1 ? width / (n - 1) : width;

const points = values
  .map((v, i) => {
    const x = +(i * step).toFixed(2);
    // padding 2px top/bottom so strokes don't clip
    const y = +(height - 2 - ((v - min) / range) * (height - 4)).toFixed(2);
    return `${x},${y}`;
  })
  .join(' ');
---

<svg
  class="spark"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label="sparkline"
  preserveAspectRatio="none"
  style={color ? `color:${color}` : ''}
>
  <line class="axis" x1="0" y1={height - 1} x2={width} y2={height - 1} />
  <polyline points={points} fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" stroke-linejoin="miter" style={color ? `stroke:${color}` : ''} />
</svg>
