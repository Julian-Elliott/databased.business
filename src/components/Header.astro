---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, SECTIONS } from '../consts';
---

<header class="site-header" data-testid="site-header">
  <a href="#main" class="sr-only">Skip to content</a>
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <a href="/" class="brand" data-testid="brand-link" aria-label={SITE_TITLE}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 28 16" width="28" height="16" role="img" aria-label="sparkline mark">
            <polyline
              points="0,12 4,9 8,11 12,4 16,7 20,2 24,8 28,5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="square"
              stroke-linejoin="miter"
            />
          </svg>
        </span>
        <span class="brand-text">databased<span class="brand-dot">.</span>business</span>
      </a>

      <div class="links" role="list">
        {SECTIONS.map((s) => (
          <HeaderLink href={s.slug} idx={s.idx}>{s.label}</HeaderLink>
        ))}
      </div>

      <a
        class="rss-link"
        href="/rss.xml"
        data-testid="rss-link"
        aria-label="RSS feed"
        title="RSS feed"
      >rss</a>
    </nav>
  </div>
  <div class="ruler" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
  }
  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: 14px 0 12px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand-mark { color: var(--signal); display: inline-flex; }
  .brand-text {
    font-family: var(--f-mono);
    font-size: 13.5px;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .brand-dot { color: var(--signal); }
  .links {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    justify-self: center;
  }
  .rss-link {
    font-family: var(--f-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 4px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  .rss-link:hover { color: var(--signal); border-color: var(--signal); }
  @media (max-width: 700px) {
    .nav { grid-template-columns: auto auto; row-gap: 8px; }
    .links {
      grid-column: 1 / -1;
      justify-self: start;
      gap: var(--s-3);
      flex-wrap: wrap;
    }
    .rss-link { display: none; }
  }
</style>
