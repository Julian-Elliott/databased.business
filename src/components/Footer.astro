---
import { AUTHOR } from '../consts';
const today = new Date();
const year = today.getFullYear();
const isoStamp = today.toISOString().slice(0, 10);

// Deterministic ASCII stamp generator. Every interior line is padded to
// exactly INNER columns so the right-hand `│` is always vertically aligned
// with the top/bottom corners — regardless of which line is longest.
const INNER = 24;
const lines = [
  `© ${year}`,
  'julian elliott',
  isoStamp,
];
const innerLines = lines.map((l) => `  ${l}`.padEnd(INNER, ' '));
const rule = '─'.repeat(INNER);
const stamp = [
  `┌${rule}┐`,
  ...innerLines.map((l) => `│${l}│`),
  `└${rule}┘`,
].join('\n');
---

<footer class="site-footer" data-testid="site-footer">
  <div class="ruler" aria-hidden="true"></div>
  <div class="wrap inner">
    <div class="col col-a">
      <div class="uppercase-mono">colophon</div>
      <p class="muted small">
        Built with Astro on Cloudflare Workers. Typeset in
        <em>Fraunces</em>, IBM Plex Sans, and IBM Plex Mono. No trackers, no
        cookies, no analytics — just hairlines and warm paper.
      </p>
    </div>

    <div class="col col-b">
      <div class="uppercase-mono">elsewhere</div>
      <ul class="links">
        <li>
          <a href={AUTHOR.github} target="_blank" rel="noopener noreferrer" data-testid="footer-github">github</a>
          <span class="dim">/{AUTHOR.handle}</span>
        </li>
        <li>
          <a href={AUTHOR.linkedin} target="_blank" rel="noopener noreferrer" data-testid="footer-linkedin">linkedin</a>
        </li>
        <li>
          <a href={AUTHOR.bluesky} target="_blank" rel="noopener noreferrer" data-testid="footer-bluesky">bluesky</a>
        </li>
        <li>
          <a href={`mailto:${AUTHOR.email}`} data-testid="footer-email">{AUTHOR.email}</a>
        </li>
      </ul>
    </div>

    <div class="col col-c">
      <div class="uppercase-mono">stamp</div>
      <pre class="stamp" aria-hidden="true"><code>{stamp}</code></pre>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--s-6); }
  .inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--s-4);
    padding: var(--s-4) 0 var(--s-5);
  }
  /* Indent each column slightly so body text doesn't feel flush against
     the wrap edge. */
  .col { padding-left: var(--s-3); }
  .col-c { padding-left: var(--s-2); }
  .small { font-size: 14.5px; max-width: 38ch; }
  .uppercase-mono { margin-bottom: var(--s-1); }
  .links { list-style: none; margin: 0; padding: 0; }
  .links li {
    font-family: var(--f-mono);
    font-size: 14px;
    color: var(--ink-2);
    padding: 3px 0;
  }
  .links a { color: var(--ink); }
  .links a:hover { color: var(--signal); }
  .dim { color: var(--ink-3); }
  .stamp {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font-size: 11.5px;
    color: var(--ink-3);
    line-height: 1.35;
    /* Critical: prevent the browser collapsing whitespace runs. `pre`
       already preserves them, but font shaping must not introduce
       proportional widths. */
    font-variant-ligatures: none;
    font-feature-settings: "tnum" 1, "calt" 0;
    white-space: pre;
  }
  .stamp code { background: none; border: 0; padding: 0; font: inherit; }
  @media (max-width: 800px) {
    .inner { grid-template-columns: 1fr; gap: var(--s-3); }
    .col, .col-c { padding-left: 0; }
  }
</style>
