---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Sparkline from '../components/Sparkline.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tag, readingTime, spark } = Astro.props;
const defaultSpark = [2, 4, 3, 6, 5, 9, 8, 12, 10, 13, 12, 16];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>
  <body>
    <Header />
    <main id="main" class="wrap" data-testid="blog-post">
      <article class="post">
        <header class="post-head">
          <div class="rubric-line">
            <span class="mono idx">field note</span>
            {tag && <span class="chip --signal">{tag}</span>}
          </div>

          <h1 class="post-title">{title}</h1>
          <p class="lead post-lead">{description}</p>

          <dl class="kv post-meta">
            <dt>published</dt><dd><FormattedDate date={pubDate} /></dd>
            {updatedDate && (<><dt>updated</dt><dd><FormattedDate date={updatedDate} /></dd></>)}
            {readingTime && (<><dt>read</dt><dd>{readingTime}</dd></>)}
            <dt>author</dt><dd>julian elliott</dd>
          </dl>

          <div class="spark-line" aria-hidden="true">
            <Sparkline values={spark && spark.length ? spark : defaultSpark} width={420} height={26} />
          </div>
        </header>

        {heroImage && (
          <figure class="hero">
            <img src={heroImage} alt="" loading="eager" />
          </figure>
        )}

        <div class="prose">
          <slot />
        </div>

        <footer class="post-foot">
          <a class="back" href="/blog" data-testid="back-to-index">← back to field notes</a>
        </footer>
      </article>
    </main>
    <Footer />

    <style is:global>
      .prose {
        max-width: 68ch;
        margin: 0 auto;
        font-size: 18.5px;
        line-height: 1.7;
        color: var(--ink-2);
      }
      .prose > * { margin-left: auto; margin-right: auto; }
      .prose h2 {
        margin-top: var(--s-5);
        margin-bottom: var(--s-2);
        font-size: var(--t-h2);
        color: var(--ink);
        font-variation-settings: "opsz" 60, "SOFT" 40;
      }
      .prose h3 {
        margin-top: var(--s-4);
        margin-bottom: var(--s-1);
        font-size: 24px;
        color: var(--ink);
      }
      .prose p { color: var(--ink-2); }
      .prose p strong, .prose li strong { color: var(--ink); }
      .prose ul, .prose ol { padding-left: 1.2em; }
      .prose li { margin-bottom: 0.5em; }
      .prose img {
        border: 1px solid var(--rule);
        border-radius: 2px;
      }
      .prose table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--f-mono);
        font-size: 13.5px;
        margin: var(--s-3) 0;
      }
      .prose th, .prose td {
        border-bottom: 1px solid var(--rule);
        padding: 8px 10px;
        text-align: left;
        color: var(--ink);
      }
      .prose th {
        background: var(--paper-2);
        color: var(--ink-3);
        font-weight: 500;
        text-transform: lowercase;
        letter-spacing: 0.04em;
      }
      .prose tr:hover td { background: color-mix(in srgb, var(--signal) 5%, transparent); }
      .prose .callout {
        border: 1px solid var(--rule);
        border-left: 3px solid var(--signal);
        padding: var(--s-2) var(--s-3);
        background: var(--bg-card);
        margin: var(--s-3) 0;
      }
      .prose .callout.--depth { border-left-color: var(--depth); }
      .prose .callout .label {
        font-family: var(--f-mono);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-3);
        display: block;
        margin-bottom: 6px;
      }
      .prose .callout p { margin: 0; color: var(--ink-2); }
      .prose .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--s-3);
        margin: var(--s-4) 0;
      }
      @media (max-width: 700px) { .prose .two-col { grid-template-columns: 1fr; } }
    </style>

    <style>
      .post { padding: var(--s-4) 0 var(--s-6); }
      .post-head { margin-bottom: var(--s-4); }
      .rubric-line {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        margin-bottom: var(--s-2);
      }
      .rubric-line .idx { font-size: var(--t-mono); color: var(--ink-3); letter-spacing: 0.06em; }
      .post-title {
        font-size: clamp(38px, 6vw, 72px);
        line-height: 1.02;
        letter-spacing: -0.025em;
        margin-bottom: var(--s-2);
        font-variation-settings: "opsz" 144, "SOFT" 40, "WONK" 1;
      }
      .post-lead { max-width: 60ch; margin-bottom: var(--s-3); }
      .post-meta {
        grid-template-columns: 90px 1fr;
        max-width: 320px;
        margin-bottom: var(--s-3);
      }
      .spark-line {
        color: var(--signal);
        max-width: 420px;
        margin-bottom: var(--s-3);
      }
      .hero {
        margin: var(--s-3) 0 var(--s-4) 0;
      }
      .hero img {
        border: 1px solid var(--rule);
        border-radius: 2px;
      }
      .post-foot {
        margin-top: var(--s-5);
        padding-top: var(--s-3);
        border-top: 1px solid var(--rule);
      }
      .back {
        font-family: var(--f-mono);
        font-size: 14px;
        color: var(--ink-2);
      }
      .back:hover { color: var(--signal); }
    </style>
  </body>
</html>
